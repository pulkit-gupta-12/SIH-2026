# ==============================================================================
# MaapSetu Legal Metrology - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate for your environment.
# DO NOT COMMIT SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-legalmetrology-development-placeholder-key-2026
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://legalmetro:legalmetro_dev@localhost:5432/legalmetro
POSTGRES_DB=legalmetro
POSTGRES_USER=legalmetro
POSTGRES_PASSWORD=legalmetro_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# OCR Microservice Configuration (PaddleOCR FastAPI Service on port 8001)
# ------------------------------------------------------------------------------
OCR_SERVICE_URL=http://localhost:8001
OCR_TIMEOUT_SECONDS=30.0
# Set to True only when running in offline development without OCR service:
OCR_USE_MOCK=False
OCR_MAX_UPLOAD_BYTES=20971520

# ------------------------------------------------------------------------------
# Ollama / Local Semantic LLM Configuration
# ------------------------------------------------------------------------------
# Set to True to enable local LLM auxiliary reasoning for semantic/ambiguous rules
LLM_ENABLED=True
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Threshold below which LLM conclusions are downgraded to human REVIEW (0.0 to 1.0)
LLM_CONFIDENCE_THRESHOLD=0.70
LLM_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# Celery & Redis Task Queue (Optional / Background Tasks)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Frontend Vite Environment
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
